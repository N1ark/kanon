    (whenSome true ((O.bool_not_ x)))
    | _, _ => none)
  <|> (match v1, (KanonBool.proj v2) with
        | x, some (.Bool false) =>
        (whenSome true ((O.bool_not_ x)))
        | _, _ => none)

def Bool.eq.r_true_ (O : Ops S) (v1 : S.Term) (v2 : S.Term) : Option S.Term :=
  (match (KanonBool.proj v1), v2 with
    | some (.Bool true), x =>
    (whenSome true (x))
    | _, _ => none)
  <|> (match v1, (KanonBool.proj v2) with
        | x, some (.Bool true) =>
        (whenSome true (x))
        | _, _ => none)

def Bool.eq.r_nots (O : Ops S) (v1 : S.Term) (v2 : S.Term) : Option S.Term :=
  (match (KanonBool.proj v1), (KanonBool.proj v2) with
    | some (.Not b), some (.Not c) =>
    (whenSome true ((O.bool_eq b c)))
    | _, _ => none)

def Bool.eq.r_default (O : Ops S) (v1 : S.Term) (v2 : S.Term) : Option S.Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome true
    ((if O.tag_le v1 v2
     then (KanonBool.mk (.Eq v1 v2) (KanonBool.sort .TBool))
     else (KanonBool.mk (.Eq v2 v1) (KanonBool.sort .TBool))))))

def Bool.eq_untyped.r_ill_typed (O : Ops S) (v1 : S.Term) (v2 : S.Term) : Option S.Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome (! (decide ((S.ty v1) = (S.ty v2)))) (KanonBool.v_false)))

def Bool.eq_untyped.r_typed (O : Ops S) (v1 : S.Term) (v2 : S.Term) : Option S.Term :=
  (match v1, v2 with | _, _ => (whenSome true ((O.bool_eq v1 v2))))

def Bool.distinct.r_small (O : Ops S) (l : (List S.Term)) : Option S.Term :=
  (match l with
    | _ =>
    (whenSome (KanonBool.Bool.at_most_one l) (KanonBool.v_true)))

def Bool.distinct.r_distinct (O : Ops S) (l : (List S.Term)) : Option S.Term :=
  (match l with
    | _ =>
    (whenSome (decide ((KanonBool.Bool.distinct_check O l) = (some true)))
    (KanonBool.v_true)))

def Bool.distinct.r_not_distinct (O : Ops S) (l : (List S.Term)) : Option S.Term :=
  (match l with
    | _ =>
    (whenSome (decide ((KanonBool.Bool.distinct_check O l) = (some false)))
    (KanonBool.v_false)))

def Bool.distinct.r_default (O : Ops S) (l : (List S.Term)) : Option S.Term :=
  (match l with
    | _ =>
    (whenSome true
    ((KanonBool.mk (.Distinct (O.bool_sort_by_tag l)) (KanonBool.sort .TBool)))))

/-- What the proofs assume of the model: its rule functions refine their specs, its oracles
and extensible helpers do what they are assumed to do. -/
structure Ops.Sound (O : Ops S) : Prop where
  bool_and_ : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bool.and_.spec v1 v2) (O.bool_and_ v1 v2)
  bool_or_ : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bool.or_.spec v1 v2) (O.bool_or_ v1 v2)
  bool_not_ : ∀ (sv : S.Term), S.Refines (Bool.not_.spec sv) (O.bool_not_ sv)
  bool_ite : ∀ (guard : S.Term) (if_ : S.Term) (else_ : S.Term), S.Refines (Bool.ite.spec guard if_ else_) (O.bool_ite guard if_ else_)
  bool_eq : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bool.eq.spec v1 v2) (O.bool_eq v1 v2)
  bool_eq_untyped : ∀ (v1 : S.Term) (v2 : S.Term), S.Refines (Bool.eq_untyped.spec v1 v2) (O.bool_eq_untyped v1 v2)
  bool_distinct : ∀ (l : (List S.Term)), S.Refines (Bool.distinct.spec l) (O.bool_distinct l)
  bool_orc : Oracle.Compat (S := S) O.bool_sort_by_tag
  bool_sure_neq : ∀ (a : S.Term) (b : S.Term), Bool.sure_neq.post a b (O.bool_sure_neq a b)

end KanonBool
