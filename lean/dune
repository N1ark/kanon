; The generated Lean files of the bool module, under Generated/KanonBool/, from the bool
; module built into kanon: `dune test` checks that they are up to date (run
; `dune exec -- kanon lean-all . +bool.knl +bool.kn` here after changing the
; module), and CI checks their proofs with `lake build`.

(rule
 (alias runtest)
 (deps
  (source_tree Generated)
  (source_tree KanonBool))
 (action
  (run %{bin:kanon} lean-all --check . +bool.knl +bool.kn)))
