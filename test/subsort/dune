; Subsorts are erased to their parent in the OCaml of the rules: the generated
; code compiles and runs on the terms of TBitVector (see ../subsort.t for the
; typed interface).

(rule
 (deps
  (glob_files *.kn*))
 (action
  (with-stdout-to
   sub_types.ml
   (run %{bin:kanon} ocaml-types lang.knl))))

(rule
 (deps
  (glob_files *.kn*))
 (action
  (with-stdout-to
   sub_rules.ml
   (run %{bin:kanon} ocaml lang.knl))))

(test
 (name main)
 (libraries zarith))
