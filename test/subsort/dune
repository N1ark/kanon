; Subsorts are erased to their parent in the OCaml of the rules: the generated
; code compiles and runs on the terms of TBitVector. The typed interface is
; implemented by the generated Derived, and the leaf nodes, which it has no
; constructor for, are added by hand (see
; ../subsort.t and ../typed_compile.t for what it rejects).

(rule
 (deps
  (glob_files *.kn*))
 (targets
  (dir gen))
 (action
  (run %{bin:kanon} ocaml gen lang.knl)))

(rule
 (copy gen/Generated/sub_types.ml sub_types.ml))

(rule
 (copy gen/Generated/sub_rules.ml sub_rules.ml))

(rule
 (copy gen/Generated/typed.ml sub_typed.ml))

(test
 (name main)
 (libraries zarith))
