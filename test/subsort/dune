; Subsorts are erased to their parent in the OCaml of the rules: the generated
; code compiles and runs on the terms of TBitVector. The typed interface is
; implemented by the generated Derived and the leaf nodes, written by hand (see
; ../subsort.t and ../typed_compile.t for what it rejects).

(rule
 (deps
  (glob_files *.kn*))
 (action
  (with-stdout-to
   sub_types.ml
   (run %{bin:kanon} ocaml-types lang.knl))))

(rule
 (deps
  (glob_files *.kn*))
 (action
  (with-stdout-to
   sub_rules.ml
   (run %{bin:kanon} ocaml lang.knl))))

(rule
 (deps
  (glob_files *.kn*))
 (action
  (with-stdout-to
   sub_typed.ml
   (run %{bin:kanon} ocaml-typed lang.knl))))

(test
 (name main)
 (libraries zarith))
