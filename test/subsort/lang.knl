(* The bit-vectors of a symbolic execution engine, where a divisor is known to
   be non-zero, in two modules. The subsorts are erased in OCaml: the terms are
   those of TBitVector (see ../typed_compile.t for the typed interface). *)

[@@@ocaml_types "Sub_types"]
[@@@ocaml_prims "Sub_prims"]
[@@@ocaml_rules "Sub_rules"]

use "bitvec"
use "cmp"
