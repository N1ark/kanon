The built-in modules: `use +name` uses the module of modules/ built into
kanon. The example language of examples/bool is made of the bool module alone
(`use +bool`); the generated files name its files bool.knl and bool.kn.

  $ kanon ocaml-check ../../examples/bool/lang.knl
  (* Generated by kanon from lang.knl, bool.knl. Do not edit. *)
  
  module _ = struct
    [@@@warning "-a@8@9"]
    open P
    let _ : string -> unit = fun _ -> ()
    let _ : t_kind -> unit = function
      | Var (_ : string) -> ()
      | Unop ((_ : unop), (_ : t)) -> ()
      | Binop ((_ : binop), (_ : t), (_ : t)) -> ()
      | Triop ((_ : triop), (_ : t), (_ : t), (_ : t)) -> ()
      | Nop ((_ : nop), (_ : (t list))) -> ()
      | Bool (_ : bool) -> ()
    let _ : unop -> unit = function
      | Not -> ()
    let _ : binop -> unit = function
      | And -> ()
      | Or -> ()
      | Eq -> ()
    let _ : triop -> unit = function
      | Ite -> ()
    let _ : nop -> unit = function
      | Distinct -> ()
    let _ : ty -> unit = function
      | TBool -> ()
  end
  $ kanon ocaml ../../examples/bool/lang.knl | head -n 20
  (* Generated by kanon from bool.kn. Do not edit. *)
  
  [@@@warning "-a"]
  
  open P
  
  module _ : sig
    val node : t_kind -> ty -> t
    val zcompare : Z.t -> Z.t -> int
    val zequal : Z.t -> Z.t -> bool
    val equal_ty : ty -> ty -> bool
    val sort_by_tag : (t list) -> (t list)
    val v_true : t
    val v_false : t
  end = P
  
  let[@inline] mk_commut_binop (op : binop) (l : t) (r : t) : t_kind =
      (if (Int.compare l.Hc.tag r.Hc.tag <= 0)
      then (Binop (op, l, r))
      else (Binop (op, r, l)))

An unknown built-in module:

  $ echo 'use +int' > int.kn
  $ kanon ocaml ../../examples/bool/lang.knl int.kn
  kanon: use "+int": no +int.knl or +int.kn
  [1]
