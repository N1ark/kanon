; The generated OCaml compiles and runs: the types and rules of the language
; of ../tiny.t, as modules (Tiny_types, Tiny_rules, opened through
; [@@@ocaml_types] and the primitives of Tiny_prims), and of the example
; language of examples/bool, included in one module (Bool_lang), and that of
; examples/arrays (Arrays_lang), with its arrays, and that of
; examples/traversals (Trav_lang), with its traversals.

(rule
 (deps
  (glob_files ../tiny.t/*.kn*))
 (targets
  (dir gen_tiny))
 (action
  (run %{bin:kanon} ocaml gen_tiny ../tiny.t/lang.knl)))

(rule
 (copy gen_tiny/Generated/tiny_types.ml tiny_types.ml))

(rule
 (copy gen_tiny/Generated/tiny_rules.ml tiny_rules.ml))

(rule
 (copy gen_tiny/Generated/tests.ml tiny_tests.ml))

(rule
 (deps %{project_root}/examples/bool/lang.knl)
 (targets
  (dir gen_bool))
 (action
  (run %{bin:kanon} ocaml gen_bool %{project_root}/examples/bool/lang.knl)))

(rule
 (copy gen_bool/Generated/types.ml bool_types.gen.ml))

(rule
 (copy gen_bool/Generated/rules.ml bool_rules.gen.ml))

(rule
 (deps
  (glob_files %{project_root}/examples/arrays/*.kn*))
 (targets
  (dir gen_arrays))
 (action
  (run
   %{bin:kanon}
   ocaml
   gen_arrays
   %{project_root}/examples/arrays/lang.knl)))

(rule
 (copy gen_arrays/Generated/types.ml arrays_types.gen.ml))

(rule
 (copy gen_arrays/Generated/rules.ml arrays_rules.gen.ml))

(rule
 (deps
  (glob_files %{project_root}/examples/traversals/*.kn*))
 (targets
  (dir gen_trav))
 (action
  (run
   %{bin:kanon}
   ocaml
   gen_trav
   %{project_root}/examples/traversals/lang.knl)))

(rule
 (copy gen_trav/Generated/types.ml trav_types.gen.ml))

(rule
 (copy gen_trav/Generated/rules.ml trav_rules.gen.ml))

; The literals of a [@fold] law do not capture the parameters of the node,
; named like them (hygiene/lang.knl).

(rule
 (deps
  (glob_files hygiene/*.kn*))
 (targets
  (dir gen_hyg))
 (action
  (run %{bin:kanon} ocaml gen_hyg hygiene/lang.knl)))

(rule
 (copy gen_hyg/Generated/hyg_types.ml hyg_types.ml))

(rule
 (copy gen_hyg/Generated/rules.ml hyg_rules.ml))

(test
 (name main)
 (libraries zarith)
 (preprocess
  (pps kanon.ppx_include_file))
 (preprocessor_deps
  bool_types.gen.ml
  bool_rules.gen.ml
  arrays_types.gen.ml
  arrays_rules.gen.ml
  trav_types.gen.ml
  trav_rules.gen.ml))
