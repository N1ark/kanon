; The generated OCaml compiles and runs: the types and rules of the language
; of ../tiny.t, as modules (Tiny_types, Tiny_rules, opened through
; [@@@ocaml_types] and the primitives of Tiny_prims), and of the example
; language of examples/bool, included in one module (Bool_lang), and that of
; examples/arrays (Arrays_lang), with its arrays.

(rule
 (deps
  (glob_files ../tiny.t/*.kn*))
 (action
  (with-stdout-to
   tiny_types.ml
   (run %{bin:kanon} ocaml-types ../tiny.t/lang.knl))))

(rule
 (deps
  (glob_files ../tiny.t/*.kn*))
 (action
  (with-stdout-to
   tiny_rules.ml
   (run %{bin:kanon} ocaml ../tiny.t/lang.knl))))

(rule
 (deps
  (glob_files ../tiny.t/*.kn*))
 (action
  (with-stdout-to
   tiny_tests.ml
   (progn
    (echo "open Tiny_rules\n")
    (run %{bin:kanon} ocaml-tests ../tiny.t/lang.knl)))))

(rule
 (deps %{project_root}/examples/bool/lang.knl)
 (action
  (with-stdout-to
   bool_types.gen.ml
   (run %{bin:kanon} ocaml-types %{project_root}/examples/bool/lang.knl))))

(rule
 (deps %{project_root}/examples/bool/lang.knl)
 (action
  (with-stdout-to
   bool_rules.gen.ml
   (run %{bin:kanon} ocaml %{project_root}/examples/bool/lang.knl))))

(rule
 (deps
  (glob_files %{project_root}/examples/arrays/*.kn*))
 (action
  (with-stdout-to
   arrays_types.gen.ml
   (run %{bin:kanon} ocaml-types %{project_root}/examples/arrays/lang.knl))))

(rule
 (deps
  (glob_files %{project_root}/examples/arrays/*.kn*))
 (action
  (with-stdout-to
   arrays_rules.gen.ml
   (run %{bin:kanon} ocaml %{project_root}/examples/arrays/lang.knl))))

(test
 (name main)
 (libraries zarith)
 (preprocess
  (pps kanon.ppx_include_file))
 (preprocessor_deps
  bool_types.gen.ml
  bool_rules.gen.ml
  arrays_types.gen.ml
  arrays_rules.gen.ml))

; The literals of a [@fold] law do not capture the parameters of the node,
; named like them (hygiene/lang.knl).

(rule
 (deps
  (glob_files hygiene/*.kn*))
 (action
  (with-stdout-to
   hyg_types.ml
   (run %{bin:kanon} ocaml-types hygiene/lang.knl))))

(rule
 (deps
  (glob_files hygiene/*.kn*))
 (action
  (with-stdout-to
   hyg_rules.ml
   (run %{bin:kanon} ocaml hygiene/lang.knl))))
