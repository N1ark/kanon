Declarations: only abstract types have parameters, and the host's equality and
hash are required, since they take those of the arguments. A container has no
constructors in patterns, and `[@noeq]` forbids `=`.

  $ for decl in "type 'a r = { x : int }" "type 'a e = A | B" "type ('a, 'a) p [@ocaml \"P.t\"] [@equal \"P.equal\"] [@hash \"P.hash\"]" "type 'a b [@ocaml \"B.t\"]" "type 'a b [@ocaml \"B.t\"] [@equal \"B.equal\"]"; do
  >   printf '%s\nsort TInt\nnode Int of int : TInt\n' "$decl" > lang.knl
  >   kanon ocaml-types lang.knl 2>&1 | head -3
  > done
  lang.knl:1:8: type r: only abstract types have type parameters
  lang.knl:1:8: type e: only abstract types have type parameters
  lang.knl:1:14: type p: type parameters must be distinct
  lang.knl:1:8: type b is parametrised: [@equal "M.equal"] is required, a function taking the equality of each argument first
  lang.knl:1:8: type b is parametrised: [@hash "M.hash"] is required, a function taking the hash of each argument first
  $ cat > lang.knl <<'KN'
  > [@@@ocaml_prims "Prims"]
  > type 'a box [@ocaml "Box.t"] [@noeq] [@equal "Box.equal"] [@hash "Box.hash"]
  > sort TInt
  > node Int of int : TInt
  > KN
  $ cat > rules.kn <<'KN'
  > fn same (a b : t box) : bool = a = b
  > KN
  $ kanon ocaml lang.knl rules.kn
  rules.kn:1:31: equality is not allowed at type t box
  [1]
  $ cat > rules.kn <<'KN'
  > fn size (b : t box) : int = match b with [] -> 0 | _ -> 1
  > KN
