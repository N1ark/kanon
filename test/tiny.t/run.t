    intro O hO v2 kanon__2 t__3 hg
    refine Refinement.trans ?_ (plus.r_zero.main.ok O hO v2 kanon__2 t__3 hg)
    simp only [plus.spec]
    refine Refinement.trans (Binop.Plus.comm.ok ..) ?_
