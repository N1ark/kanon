      (match v1, v2 with
      | (x, { kind = Int (kanon__2); _ })
        when (((Z.equal kanon__2 Z.one))) ->
        x
      | ({ kind = Int (kanon__2); _ }, x)
        when (((Z.equal kanon__2 Z.one))) ->
        x
      | (_, { kind = Int (kanon__2); _ })
        when (((Z.equal kanon__2 Z.zero))) ->
        (node (Int (Z.zero)) TInt)
      | ({ kind = Int (kanon__2); _ }, _)
        when (((Z.equal kanon__2 Z.zero))) ->
        (node (Int (Z.zero)) TInt)
      | _ -> (node (mk_commut_binop Times v1 v2) TInt)
      ))
  
