        | ({ kind = Op1 ((Not), kanon__3); _ }, x)
          when ((Int.equal x.tag kanon__3.tag)) ->
          Tiny_prims.v_false
        | _ -> (node (mk_commut_binop And v1 v2) TBool)
        ))
    
