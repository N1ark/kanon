                   true
                 | _ -> false
                 ) [@warning "-11"]);
        (match v1, v2 with
        | (x, kanon__2)
          when ((Int.equal x.tag kanon__2.tag)) ->
          Tiny_prims.v_true
        | ({ kind = Int (x); _ }, { kind = Int (y); _ }) ->
          (rules_of_bool ((Z.equal x y)))
        | _ -> (node (mk_commut_binop Eq v1 v2) TBool)
        ))
    
