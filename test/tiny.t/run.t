      (match v1, v2 with
      | ({ kind = Int (i1); _ }, { kind = Int (i2); _ }) ->
        (node (Int ((add i1 i2))) TInt)
      | (x, { kind = Int (kanon__2); _ })
        when (((Z.equal kanon__2 Z.zero))) ->
        x
      | ({ kind = Int (kanon__2); _ }, x)
        when (((Z.equal kanon__2 Z.zero))) ->
        x
      | _ -> (node (mk_commut_binop Plus v1 v2) TInt)
      ))
  
