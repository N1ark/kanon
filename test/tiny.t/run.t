  theorem plus.r_lits.proof : plus.r_lits.Stmt := by
    intro O hO v1 v2 res h
    simp only [plus.r_lits] at h
    repeat' rcases orElse_some h with h | h
    · kanon_arm h (plus.r_lits.main.ok O hO)
  
