prim equal : t -> t -> bool
prim int : int -> t
prim v_true : t
prim v_false : t

fn of_bool (b : bool) : t = if b then v_true else v_false

rule plus : Plus (v1, v2) =
  | lits: #x + #y -> int (x + y)
  | zero: x + 0 -> x

rule not_ : Not v =
  | lit: true -> v_false
  | not_not: not x -> x

rule and_ : And (v1, v2) =
  | not_: x && not y when equal x y -> v_false

rule eq : Eq (v1, v2) =
  | same: x == x -> v_true
  | lits: #x == #y -> of_bool (x = y)
