(* A small value language: booleans and mathematical integers, in one module.
   The terms are those of an OCaml module with the types [t_kind], [ty],
   [unop] and [binop], and the constructors below. Its rules are in
   rules.kn. *)

use "rules"

type var [@ocaml "string"] [@lean "String"] [@noeq]

type kind [@ocaml "t_kind"] [@noeq] =
  | Var of var
  | Bool
  | Int
  | Unop of unop * t [@operators]
  | Binop of binop * t * t [@operators]

type unop = Not
type binop = And | Plus | Eq
type ty = TBool | TInt

node Bool of bool [@literal] [@to_term "of_bool"]
node Int of int [@literal "int"]
node Not : TBool -> TBool
node And : TBool -> TBool -> TBool [@comm] [@idem] [@unit "true"]
    [@zero "false"]
node Plus : TInt -> TInt -> TInt [@comm]
node Eq : a -> b -> TBool when a = b [@comm]
node TBool
node TInt

infix "&&" = And, and_
infix "+" = Plus, plus
infix "==" = Eq, eq
prefix "not" = Not, not_

constant "true" (v) = v_true
constant "false" (v) = v_false
