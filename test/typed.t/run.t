The ocaml-typed backend generates the OCaml interface of the smart constructors
of a language, where terms are typed by ghost tags.

  $ cat > lang.knl <<'KN'
  > [@@@ghost "sint" "[ `NonZero | `Zero ]"]
  > [@@@ghost "nonzero" "[ `NonZero ]"]
  > [@@@ghost "sint_ovf" "[ sint | `Overflowed ]"]
  > [@@@ghost "'a sseq" "[ `List of 'a ]"]
  > 
  > use builtin "bool"
  > use "rules"
  > 
  > type checked = { signed : bool; unsigned : bool }
  > 
  > (** Bit-vectors of a width. *)
  > sort TBitVec of nat [@ghost sint]
  > (** Sequences of terms of a sort. *)
  > sort TSeq of ty [@ghost sseq]
  > 
  > (** A bit-vector literal. *)
  > node BitVec of int * nat (v, n) : TBitVec n [@ctor mk_bv]
  > (** Addition, which may overflow. *)
  > node Add of checked (c) : TBitVec n -> TBitVec n -> TBitVec n [@ghost "sint" "sint" "sint_ovf"]
  > (** Division: the divisor is known to be non-zero. *)
  > node Div : TBitVec n -> TBitVec n -> TBitVec n [@ghost "sint" "nonzero" "sint_ovf"]
  > node Ult : TBitVec n -> TBitVec n -> TBool
  > node Seq : a list -> TSeq a [@ctor mk_seq]
  > node Len : TSeq a -> TBitVec 32
  > node Unspecified : TBitVec n -> TBitVec n -> TBitVec n
  > KN
  $ cat > rules.kn <<'KN'
  > (** Adds two bit-vectors. *)
  > rule bv_add : Add (c, v1, v2)
  > rule bv_div : Div (v1, v2)
  > rule bv_ult : Ult (v1, v2)
  > rule len : Len v
  > KN
  $ kanon ocaml-typed lang.knl
  (* Generated by kanon from lang.knl, bool.knl, bool.kn, rules.kn. Do not edit. *)
  
  module type S = sig
    (** {2 Ghost tags} *)
    
    module T : sig
      type sint = [ `NonZero | `Zero ]
      type nonzero = [ `NonZero ]
      type sint_ovf = [ sint | `Overflowed ]
      type 'a sseq = [ `List of 'a ]
      type sbool = [ `Bool ]
    end
    
    open T
    
    (** {2 Types} *)
    
    (** A sort of terms, phantom-typed by the tag of its terms. *)
    type +'a ty
    
    (** A term, phantom-typed by its tag. *)
    type +'a t
    
    (** The untyped terms and sorts: instantiated with [with type raw = ...]. *)
    type raw
    type raw_ty
    
    (** {2 Escape hatches} *)
    
    (** Forgets the tag of a term. *)
    val untyped : 'a t -> raw
    
    (** Trusts the tag of a term: its type is not checked. *)
    val type_ : raw -> 'a t
    
    (** Changes the tag of a term: unchecked. *)
    val cast : 'a t -> 'b t
    
    (** Forgets the tag of a sort. *)
    val untype_type : 'a ty -> raw_ty
    
    (** Trusts the tag of a sort: unchecked. *)
    val type_type : raw_ty -> 'a ty
    
    (** {2 Sorts} *)
    
    (** Bit-vectors of a width. *)
    val t_bitvec : int -> [> sint ] ty
    
    (** Sequences of terms of a sort. *)
    val t_seq : 'a ty -> [> 'a sseq ] ty
    
    val t_bool : [> sbool ] ty
    
    (** {2 Smart constructors} *)
    
    val b_and : [< sbool ] t -> [< sbool ] t -> [> sbool ] t
    val b_or : [< sbool ] t -> [< sbool ] t -> [> sbool ] t
    val b_not : [< sbool ] t -> [> sbool ] t
    val b_ite : [< sbool ] t -> 'a t -> 'a t -> 'a t
    val sem_eq : 'a t -> 'a t -> [> sbool ] t
    val sem_eq_untyped : 'a t -> 'a t -> [> sbool ] t
    val b_distinct : 'a t list -> [> sbool ] t
    
    (** Adds two bit-vectors. *)
    val bv_add : checked -> [< sint ] t -> [< sint ] t -> [> sint_ovf ] t
    
    (** Division: the divisor is known to be non-zero. *)
    val bv_div : [< sint ] t -> [< nonzero ] t -> [> sint_ovf ] t
    
    val bv_ult : [< sint ] t -> [< sint ] t -> [> sbool ] t
    val len : [< 'a sseq ] t -> [> sint ] t
    
    (** A bit-vector literal. *)
    val mk_bv : Z.t -> int -> [> sint ] t
    
    val mk_seq : 'a t list -> [> 'a sseq ] t
  end

Tags come from the sorts (`TBitVec` is `sint`, `TBool` is `sbool`, declared by
the bool module), a sort variable is shared (`b_ite`, `sem_eq`), the tag of a
sequence has a parameter (`mk_seq`, `len`), and `[@ghost]` on a node refines
them: the divisor of `bv_div` is `nonzero`, and `bv_add` may overflow. The docs
of the rule or, failing that, of the node, are carried to the `val`. Parameters
are plain arguments. A node without a rule function or `[@ctor]` has no `val`
(`Unspecified`).

A node with no tag derivable from its sorts, and no `[@ghost]`, gets any tag:

  $ cat > any.knl <<'KN'
  > [@@@ghost "sint" "[ `Int ]"]
  > sort TInt [@ghost sint]
  > sort TOther
  > node Cast : TInt -> TOther
  > node Neg : TOther -> TInt
  > KN
  $ cat > any.kn <<'KN'
  > rule cast : Cast v
  > rule neg : Neg v
  > KN
  $ kanon ocaml-typed any.knl any.kn | sed -n '/Sorts/,$p'
    (** {2 Sorts} *)
    
    val t_int : [> sint ] ty
    val t_other : _ ty
    
    (** {2 Smart constructors} *)
    
    val cast : [< sint ] t -> _ t
    val neg : _ t -> [> sint ] t
  end

The tags are checked:

  $ cat > bad.knl <<'KN'
  > sort TInt [@ghost sint]
  > KN
  $ kanon ocaml-typed bad.knl bad.knl
  bad.knl:1:18: unknown ghost tag sint: declare it with [@@@ghost]
  [1]
