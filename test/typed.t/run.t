The ocaml-typed backend generates the OCaml interface of the smart constructors
of a language, where terms are typed by ghost tags, and the implementation of
the phantom types.

  $ cat > lang.knl <<'KN'
  > use builtin "bool"
  > use "rules"
  > 
  > type checked = { signed : bool; unsigned : bool }
  > 
  > (** Bit-vectors of a width. *)
  > sort TBitVec of nat
  > (** Bit-vectors that are not zero. *)
  > subsort TNonzero of nat : TBitVec n
  > subsort TZero of nat : TBitVec n
  > (** Sequences of terms of a sort. *)
  > sort TSeq of ty
  > 
  > (** A bit-vector literal. *)
  > node BitVec of int * nat (v, n) : TBitVec n [@ctor mk_bv]
  > (** The zero of a width. *)
  > node Zero of nat (n) : TZero n [@ctor mk_zero]
  > (** Addition, which may overflow. *)
  > node Add of checked (c) : TBitVec n -> TBitVec n -> TBitVec n
  > (** Division: the divisor is known to be non-zero. *)
  > node Div : TBitVec n -> TNonzero n -> TBitVec n
  > node Ult : TBitVec n -> TBitVec n -> TBool
  > node Seq : a list -> TSeq a [@ctor mk_seq]
  > node Len : TSeq a -> TBitVec 32
  > node Unspecified : TBitVec n -> TBitVec n -> TBitVec n
  > KN
  $ cat > rules.kn <<'KN'
  > (** Adds two bit-vectors. *)
  > rule bv_add : Add (c, v1, v2)
  > rule bv_div : Div (v1, v2)
  > rule bv_ult : Ult (v1, v2)
  > rule len : Len v
  > KN
  $ kanon ocaml-typed lang.knl
  (* Generated by kanon from lang.knl, bool.knl, bool.kn, rules.kn. Do not edit. *)
  
  (** The ghost tag types of the sorts: a sort that has subsorts has their variants too, which a term of the sort may be. *)
  module Tag = struct
    type tnonzero = [ `TNonzero ]
    type tzero = [ `TZero ]
    type tbitvec = [ `TBitVec | tnonzero | tzero ]
    type tseq = [ `TSeq ]
    type tbool = [ `TBool ]
  end
  
  module type S = sig
    open Tag
    
    (** {2 Types} *)
    
    (** The untyped terms and sorts, of the types of the language. *)
    type raw = t
    type raw_ty = ty
    
    (** A sort of terms, phantom-typed by the tag of its terms. *)
    type +'a ty
    
    (** A term, phantom-typed by its tag. *)
    type +'a t
    
    (** {2 Escape hatches} *)
    
    (** Forgets the tag of a term. *)
    val untyped : 'a t -> raw
    
    (** Trusts the tag of a term: its type is not checked. *)
    val type_ : raw -> 'a t
    
    (** Changes the tag of a term: unchecked. *)
    val cast : 'a t -> 'b t
    
    (** Forgets the tag of a sort. *)
    val untype_type : 'a ty -> raw_ty
    
    (** Trusts the tag of a sort: unchecked. *)
    val type_type : raw_ty -> 'a ty
    
    (** {2 Sorts} *)
    
    (** Bit-vectors of a width. *)
    val t_bitvec : int -> [> tbitvec ] ty
    
    (** Sequences of terms of a sort. *)
    val t_seq : _ ty -> [> tseq ] ty
    
    val t_bool : [> tbool ] ty
    
    (** {2 Smart constructors} *)
    
    val b_and : [< tbool ] t -> [< tbool ] t -> [> tbool ] t
    val b_or : [< tbool ] t -> [< tbool ] t -> [> tbool ] t
    val b_not : [< tbool ] t -> [> tbool ] t
    val b_ite : [< tbool ] t -> 'a t -> 'a t -> 'a t
    val sem_eq : 'a t -> 'a t -> [> tbool ] t
    val sem_eq_untyped : 'a t -> 'a t -> [> tbool ] t
    val b_distinct : 'a t list -> [> tbool ] t
    
    (** Adds two bit-vectors. *)
    val bv_add : checked -> [< tbitvec ] t -> [< tbitvec ] t -> [> tbitvec ] t
    
    (** Division: the divisor is known to be non-zero. *)
    val bv_div : [< tbitvec ] t -> [< tnonzero ] t -> [> tbitvec ] t
    
    val bv_ult : [< tbitvec ] t -> [< tbitvec ] t -> [> tbool ] t
    val len : [< tseq ] t -> [> tbitvec ] t
    
    (** A bit-vector literal. *)
    val mk_bv : Z.t -> int -> [> tbitvec ] t
    
    (** The zero of a width. *)
    val mk_zero : int -> [> tzero ] t
    
    val mk_seq : 'a t list -> [> tseq ] t
    
    (** {2 Destructors} *)
    
    val as_bitvec : _ t -> (Z.t * int) option
    val is_bitvec : _ t -> bool
    val as_zero : _ t -> int option
    val is_zero : _ t -> bool
    val as_bool : _ t -> bool option
    val is_bool : _ t -> bool
    val as_add : _ t -> (checked * [> tbitvec ] t * [> tbitvec ] t) option
    val is_add : _ t -> bool
    val as_div : _ t -> ([> tbitvec ] t * [> tnonzero ] t) option
    val is_div : _ t -> bool
    val as_ult : _ t -> ([> tbitvec ] t * [> tbitvec ] t) option
    val is_ult : _ t -> bool
    val as_seq : _ t -> 'a t list option
    val is_seq : _ t -> bool
    val as_len : _ t -> [> tseq ] t option
    val is_len : _ t -> bool
    val as_unspecified : _ t -> ([> tbitvec ] t * [> tbitvec ] t) option
    val is_unspecified : _ t -> bool
    val as_not : _ t -> [> tbool ] t option
    val is_not : _ t -> bool
    val as_and : _ t -> ([> tbool ] t * [> tbool ] t) option
    val is_and : _ t -> bool
    val as_or : _ t -> ([> tbool ] t * [> tbool ] t) option
    val is_or : _ t -> bool
    val as_eq : _ t -> ('a t * 'a t) option
    val is_eq : _ t -> bool
    val as_ite : _ t -> ([> tbool ] t * 'a t * 'a t) option
    val is_ite : _ t -> bool
    val as_distinct : _ t -> 'a t list option
    val is_distinct : _ t -> bool
    val as_tbitvec : _ ty -> int option
    val is_tbitvec : _ ty -> bool
    val as_tseq : _ ty -> raw_ty option
    val is_tseq : _ ty -> bool
    val as_tbool : _ ty -> unit option
    val is_tbool : _ ty -> bool
  end
  
  (** The phantom types of [S], over the types of the language, with the escape hatches, which are the identity, and the sorts: [module Typed : S = struct include Ghost include Rules ... end] only needs what is not generated, such as the leaf nodes. *)
  module Ghost = struct
    type raw = t
    type raw_ty = ty
    type nonrec 'a t = raw
    type nonrec 'a ty = raw_ty
    
    let untyped : 'a t -> raw = Fun.id
    let type_ : raw -> 'a t = Fun.id
    let cast : 'a t -> 'b t = Fun.id
    let untype_type : 'a ty -> raw_ty = Fun.id
    let type_type : raw_ty -> 'a ty = Fun.id
    let t_bitvec a1 = TBitVec (a1)
    let t_seq a1 = TSeq (a1)
    let t_bool = TBool
  end

A sort has a tag type, the lowercase name of its constructor, in `Tag`: the
variant of its name, and for a sort that has subsorts, their tag types. A term
of a subsort is accepted wherever its parent sort is, and not the reverse: an
operand `[< tbitvec ] t` accepts any bit-vector, `[< tnonzero ] t` (the divisor
of `bv_div`) only those that are known to be non-zero. A result is `[> tag ] t`:
`mk_zero` builds a `tzero`, and `bv_add` a `tbitvec`, which has to be cast to
be a divisor. The docs of the rule or, failing that, of the node, are carried
to the `val`. Parameters are plain arguments. A node without a rule function or
`[@ctor]` has no `val` (`Unspecified`), but it has its destructors.

A sort variable is shared by the operands and the result (`b_ite`), and a
sort that the typing does not determine, or a node without a typing, has any
tag:

  $ cat > any.knl <<'KN'
  > type var [@ocaml "string"]
  > sort TInt
  > sort TOther
  > node Var of var [@ctor mk_var]
  > node Cast : TInt -> TOther
  > node Neg : TOther -> TInt
  > KN
  $ cat > any.kn <<'KN'
  > rule cast : Cast v
  > rule neg : Neg v
  > KN
  $ kanon ocaml-typed any.knl any.kn | sed -n '/Sorts/,/Destructors/p'
    (** {2 Sorts} *)
    
    val t_int : [> tint ] ty
    val t_other : [> tother ] ty
    
    (** {2 Smart constructors} *)
    
    val cast : [< tint ] t -> [> tother ] t
    val neg : [< tother ] t -> [> tint ] t
    val mk_var : var -> _ t
    
    (** {2 Destructors} *)

The `nat` parameters of a node are `int`s, like those of a sort, and the other
integers are `Z.t`. The sorts that are parameters of a node are raw (`raw_ty`):
their tag is not known, and the terms that are parameters (not operands) have
any tag:

  $ cat > params.knl <<'KN'
  > use builtin "bool"
  > type var = { id : int }
  > sort TBitVec of nat
  > node Extract of nat * nat (i, j) : TBitVec n -> TBitVec (j - i + 1)
  > node Lit of int * nat (v, n) : TBitVec n [@ctor lit]
  > node Exists of (var * ty) list * t : TBool
  > node Eqz : TBitVec n -> TBool
  > KN
  $ cat > params.kn <<'KN'
  > rule extract : Extract (i, j, v)
  > rule mk_exists : Exists (vars, body)
  > KN
  $ kanon ocaml-typed params.knl params.kn | sed -n '/Smart/,/Destructors/p' | grep -v "b_\|sem_eq"
    (** {2 Smart constructors} *)
    
    val extract : int -> int -> [< tbitvec ] t -> [> tbitvec ] t
    val mk_exists : ((var * raw_ty) list) -> _ t -> [> tbool ] t
    val lit : Z.t -> int -> [> tbitvec ] t
    
    (** {2 Destructors} *)

A rule function whose spec is not a single node over its parameters is typed
by the outermost node of its spec: the result has the tag of that node, a
parameter that is an operand of it has the tag of the operand, and any other
parameter has any tag. The spec of `to_bool` is `Not (Eqz v)`, where `v` is not
an operand of `Not`; that of `lt_zero` is a node over a term that is not a
parameter; and that of `fmod` is not a node:

  $ cat > comp.knl <<'KN'
  > use builtin "bool"
  > sort TBitVec of nat [@get size]
  > sort TFloat
  > node Eqz : TBitVec n -> TBool
  > node Ult : TBitVec n -> TBitVec n -> TBool
  > node FRem : TFloat -> TFloat -> TFloat
  > node Zero of nat (n) : TBitVec n
  > KN
  $ cat > comp.kn <<'KN'
  > prim size : t -> int
  > rule to_bool (v : t) : Not (Eqz v)
  > rule ult_swapped (a b : t) : Ult (b, a)
  > rule lt_zero (v : t) : Ult (v, Zero (size v))
  > rule fmod (v1 v2 : t) : raw_fmod (FRem (v1, v2)) v1
  > fn raw_fmod (r v : t) : t = r
  > KN
  $ kanon ocaml-typed comp.knl comp.kn 2>&1 | sed -n '/Smart/,/Destructors/p' | grep -v "b_\|sem_eq"
    (** {2 Smart constructors} *)
    
    val to_bool : _ t -> [> tbool ] t
    val ult_swapped : [< tbitvec ] t -> [< tbitvec ] t -> [> tbool ] t
    val lt_zero : [< tbitvec ] t -> [> tbool ] t
    val fmod : _ t -> _ t -> _ t
    
    (** {2 Destructors} *)

A sort and a subsort whose names differ by their case would have the same tag
type (two sorts would have the same destructors):

  $ cat > clash.knl <<'KN'
  > sort TInt
  > subsort TINT : TInt
  > KN
  $ echo > none.kn
  $ kanon ocaml-typed clash.knl none.kn
  kanon: TInt and TINT have the same tag type, tint
  [1]

The destructors share their names with the functions of the rules, which they
may not take (see the `ocaml` backend):

  $ cat > clash.kn <<'KN'
  > rule is_cast : Cast v
  > KN
  $ kanon ocaml-typed any.knl clash.kn
  clash.kn:1:0: is_cast is the destructor of Cast: rename the function
  [1]
