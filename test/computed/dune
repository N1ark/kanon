; Nodes built at a computed sort: the generated OCaml compiles, and builds the
; nodes at the expected sorts (see ../computed_sort.t).

(rule
 (deps
  (glob_files *.kn*))
 (targets
  (dir gen))
 (action
  (run %{bin:kanon} ocaml gen lang.knl)))

(rule
 (copy gen/Generated/cs_types.ml cs_types.ml))

(rule
 (copy gen/Generated/rules.ml cs_rules.ml))

(test
 (name main)
 (libraries zarith))
