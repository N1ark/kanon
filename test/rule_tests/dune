; The generated differential tests of the rules (tests.ml) compile and run, for a
; rule whose spec annotates the sort of an operand, with names that have primes,
; and for nat in signatures.

(rule
 (deps
  (glob_files *.kn*))
 (targets
  (dir gen))
 (action
  (run %{bin:kanon} ocaml gen lang.knl)))

(rule
 (copy gen/Generated/rt_types.ml rt_types.ml))

(rule
 (copy gen/Generated/rt_rules.ml rt_rules.ml))

(rule
 (copy gen/Generated/tests.ml rt_tests.ml))

(test
 (name main)
 (libraries zarith))
