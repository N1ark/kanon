; The destructors as_foo and is_foo of the nodes and sorts: the generated OCaml
; compiles, and they take apart the terms and sorts of every kind of node
; (leaf, parameters and operands, n-ary).

(rule
 (deps
  (glob_files *.kn*))
 (targets
  (dir gen))
 (action
  (run %{bin:kanon} ocaml gen lang.knl)))

(rule
 (copy gen/Generated/ds_types.ml ds_types.ml))

(rule
 (copy gen/Generated/rules.ml ds_rules.ml))

(test
 (name main)
 (libraries zarith))
