(* A tiny value language: booleans and integers. *)

use "rules"

type var [@ocaml "string"] [@lean "String"]

type t =
  | Var of var
  | Unop of unop * t [@operators]
  | Binop of binop * t * t [@operators]

type unop
type binop

node Bool of bool : TBool [@literal]
node Int of int : TInt [@literal int]
node Not : TBool -> TBool [@invol] [@fold negb]
node And : TBool -> TBool -> TBool [@comm] [@idem] [@unit true] [@zero false]
node Plus : TInt -> TInt -> TInt [@comm] [@unit 0] [@fold add]
node Eq : a -> a -> TBool [@comm]

sort TBool
sort TInt

infix "&&" = And, and_
infix "+" = Plus, plus
infix "==" = Eq, eq
prefix "not" = Not, not_
