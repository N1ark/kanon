(* A new language: declare its nodes here, and write its rules in rules.kn.
   [use builtin "bool"] adds Kanon's bool module. *)

[@@@ocaml_rules "Rules"]

use "rules"

type var [@ocaml "string"] [@lean "Int"]

node Var of var
node Int of int : TInt
node Plus : TInt -> TInt -> TInt [@comm]
sort TInt

notation Int

infix "+" = Plus, plus
