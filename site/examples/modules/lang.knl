(* The language: Kanon's bool module, and a module of integers. Kanon places
   the nodes of the modules in the types below. *)

[@@@ocaml_prims "Prims"]

use +bool
use "int"

type var [@ocaml "string"] [@lean "String"]

type t =
  | Var of var
  | Unop of unop * t [@operators]
  | Binop of binop * t * t [@operators]
  | Triop of triop * t * t * t [@operators]
  | Nop of nop * t list [@operators]

type unop
type binop
type triop
type nop = Distinct
