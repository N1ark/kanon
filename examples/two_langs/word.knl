(* The word module: integers of a width, whose nodes take the data of the cfg
   module as arguments. It is proved once, in Lean, under WordMod: its helpers
   match a sort, a node inside a node, and data. *)

[@@@lean_module "WordMod"]

use builtin "bool"
use "cfg"

(** Integers of a width. *)
sort TWord of int

(** The integer `z`, of width `n`. *)
node Wd of int * int (_, n) : TWord n
(** The sum of two words of width `n`. *)
node WAdd of flags * int (_, n) : TWord n -> TWord n -> TWord n
(** A word, rounded. *)
node WRound of mode * int (_, n) : TWord n -> TWord n
(** The bits of a blob, as a byte. *)
node WBlob of blob * label : TWord 8
