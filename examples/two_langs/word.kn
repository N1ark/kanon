(* the width of the integer [z] *)
prim fit : int -> int

(* the sum of two integers, computed by hand *)
oracle wsum : int -> int -> int

(* whether [z] is a checked integer, computed by hand *)
oracle wcheck : int -> int option

(* its first argument *)
fn first (a _ : int) : int = a

(* whether [s] is the sort of words *)
fn is_word (s : ty) : bool =
  match s with
  | TWord _ -> true
  | _ -> false

(* the literal on the left of a sum, or 0 *)
fn left_lit (v : t) : int =
  match v with
  | WAdd (_, _, Wd (z, _), _) -> z
  | _ -> 0

(* the flags of a plain sum *)
fn plain : flags = { wrap = false; strict = false }

(* whether [m] rounds down *)
fn is_down (m : mode) : bool =
  match m with
  | Down -> true
  | Up -> false

(* the sum of [v] with itself, at width [n] *)
fn twice (n : int) (v : t) : t = WAdd (plain, n, v, v)

rule add : WAdd (f, n, v1, v2) =
  | lits: Wd (x, _), Wd (y, _) -> Wd (wsum x y, n)
  | plain: a, b when left_lit a = 0 && not f.strict -> WAdd (plain, n, a, b)

rule round : WRound (m, n, v) =
  | check: Wd (z, _) as x -> (
      match wcheck z with
      | Some _ -> WRound (m, n, x)
      | None -> WRound (m, n, x))
  | keep: x when (is_down m || m = Up) && is_word (type_of x) -> x

(* a choice, by the rule of the bool module that this module lifts *)
rule choose : Ite (g, a, b) = Bool.ite g a b

(* a spec that is a helper *)
rule double (n : int) (v : t) : twice n v = WAdd (plain, n, v, v)
