(* The num module: integers, their sum, their order and their maximum. Three
   languages use it (l1.knl, l2.knl and l3.knl): it is proved once, in Lean,
   under NumMod (lean/NumMod), and each language only gives its interface. *)

[@@@lean_root "NumMod"]

node Num of int : TNum
node Add : TNum -> TNum -> TNum [@comm] [@unit 0]
node Lt : TNum -> TNum -> TBool
(** The maximum of two integers. *)
node Max : TNum -> TNum -> TNum

sort TNum

notation Num

infix "+" = Add, add
infix "lt" = Lt, less
