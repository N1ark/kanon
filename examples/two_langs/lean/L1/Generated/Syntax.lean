import KanonBool.Generated.Node
import NumMod.Generated.Node
import L1.Generated.Node

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

noncomputable section

namespace L1

open Classical Kanon

/-- The sorts of the language: those of its modules. -/
inductive Ty where
  | bool (s : KanonBool.Srt)
  | num (s : NumMod.Srt)
  deriving DecidableEq, Repr

/-- The terms of the language: the nodes of its modules, at a sort. -/
inductive Term where
  | bool (n : KanonBool.Node Term) (t : Ty)
  | num (n : NumMod.Node Term) (t : Ty)
  | l1 (n : L1.Node Term) (t : Ty)

/-- The sort of a term. -/
def Term.ty : Term → Ty
  | .bool _ t | .num _ t | .l1 _ t => t

instance : Inhabited Ty := ⟨.bool default⟩
instance : Inhabited Term := ⟨.bool (.Bool default) default⟩

end L1
