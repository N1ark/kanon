; The generated Lean files of the four languages (under L1/, L2/, L3/ and L4/)
; and of their modules proved once (under NumMod/, NegMod/, EvenMod/, MixMod/,
; CfgMod/ and WordMod/), from ../l1.knl to ../l4.knl: `dune test` checks that
; they are up to date (run `dune exec -- kanon lean-all . ../lN.knl` here after
; changing a language or a module), and CI checks their proofs with `lake
; build`. The languages generate the same files of the modules they share.

(rule
 (alias runtest)
 (deps
  (source_tree L1)
  (source_tree NumMod)
  ../l1.knl
  ../num.knl
  ../num.kn)
 (action
  (run %{bin:kanon} lean-all --check . ../l1.knl)))

(rule
 (alias runtest)
 (deps
  (source_tree L2)
  (source_tree NumMod)
  (source_tree NegMod)
  ../l2.knl
  ../num.knl
  ../num.kn
  ../neg.knl
  ../neg.kn)
 (action
  (run %{bin:kanon} lean-all --check . ../l2.knl)))

(rule
 (alias runtest)
 (deps
  (source_tree L3)
  (source_tree NumMod)
  (source_tree NegMod)
  (source_tree EvenMod)
  (source_tree MixMod)
  ../l3.knl
  ../num.knl
  ../num.kn
  ../neg.knl
  ../neg.kn
  ../even.knl
  ../even.kn
  ../mix.knl
  ../mix.kn)
 (action
  (run %{bin:kanon} lean-all --check . ../l3.knl)))

(rule
 (alias runtest)
 (deps
  (source_tree L4)
  (source_tree CfgMod)
  (source_tree WordMod)
  ../l4.knl
  ../cfg.knl
  ../word.knl
  ../word.kn)
 (action
  (run %{bin:kanon} lean-all --check . ../l4.knl)))
