; The generated Lean files of the five languages (under Generated/L1/ to Generated/L5/)
; and of their modules proved once (under Generated/NumMod/, Generated/NegMod/,
; Generated/EvenMod/, Generated/MixMod/, Generated/CfgMod/, Generated/WordMod/
; and Generated/PackMod/), from ../l1.knl to ../l5.knl: `dune test` checks that
; they are up to date (run `dune exec -- kanon lean . ../lN.knl` here after
; changing a language or a module, for each N), and CI checks their proofs with
; `lake build`. The languages generate the same files of the modules they
; share.

(rule
 (alias runtest)
 (deps
  (source_tree Generated/L1)
  (source_tree L1)
  (source_tree Generated/NumMod)
  (source_tree NumMod)
  ../l1.knl
  ../num.knl
  ../num.kn)
 (action
  (run %{bin:kanon} lean --check . ../l1.knl)))

(rule
 (alias runtest)
 (deps
  (source_tree Generated/L2)
  (source_tree L2)
  (source_tree Generated/NumMod)
  (source_tree NumMod)
  (source_tree Generated/NegMod)
  (source_tree NegMod)
  ../l2.knl
  ../num.knl
  ../num.kn
  ../neg.knl
  ../neg.kn)
 (action
  (run %{bin:kanon} lean --check . ../l2.knl)))

