; The generated Lean files of the example, from ../../lang.knl and its vec
; module: `dune test` checks that the committed files are up to date (run
; `dune promote` after changing the language or the modules), and CI checks
; that they compile with `lake build`.
; The example has a model but no proofs (see ../../lang.knl).

(rule
 (deps ../../lang.knl ../../vec.knl ../../vec.kn)
 (targets
  Types.lean.gen
  Syntax.lean.gen
  Signatures.lean.gen
  Typing.lean.gen
  Model.lean.gen)
 (action
  (progn
   (with-stdout-to
    Types.lean.gen
    (run %{bin:kanon} lean-types ../../lang.knl))
   (with-stdout-to
    Syntax.lean.gen
    (run %{bin:kanon} lean-syntax ../../lang.knl))
   (with-stdout-to
    Signatures.lean.gen
    (run %{bin:kanon} lean-signatures ../../lang.knl))
   (with-stdout-to
    Typing.lean.gen
    (run %{bin:kanon} lean-typing ../../lang.knl))
   (with-stdout-to
    Model.lean.gen
    (run %{bin:kanon} lean-model ../../lang.knl)))))

(rule
 (alias runtest)
 (action
  (progn
   (diff Types.lean Types.lean.gen)
   (diff Syntax.lean Syntax.lean.gen)
   (diff Signatures.lean Signatures.lean.gen)
   (diff Typing.lean Typing.lean.gen)
   (diff Model.lean Model.lean.gen))))
