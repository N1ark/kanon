; The generated Lean files of the example, under Generated/ArraysExample/, from
; ../lang.knl and its vec module (under Generated/ArraysExample/Vec/): `dune test` checks
; that they are up to date (run `dune exec -- kanon lean . ../lang.knl` here
; after changing the language or the modules), and CI checks their proofs with
; `lake build`.

(rule
 (alias runtest)
 (deps
  (source_tree Generated)
  (source_tree ArraysExample)
  ../lang.knl
  ../vec.knl
  ../vec.kn)
 (action
  (run %{bin:kanon} lean --check . ../lang.knl)))
