(* An example language of integers and of arrays of integers, on Kanon's bool
   module: it shows the built-in immutable arrays, whose type [int array] is
   the argument of a node, and which rules build, read, update and compare. Its
   OCaml is tested in test/ocaml, and its Lean model is in lean/. *)

[@@@lean_root "ArraysExample"]
[@@@ocaml_prims "Prims"]

use builtin "bool"
use "vec"
