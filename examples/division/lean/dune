; The generated Lean files of the example, under DivisionExample/Generated/, from
; ../lang.knl and its int module (with a subsort): `dune test` checks that they
; are up to date (run `dune exec -- kanon lean-all . ../lang.knl` here after
; changing the language or the modules), and CI checks their proofs with `lake
; build`.

(rule
 (alias runtest)
 (deps
  (source_tree DivisionExample)
  (source_tree DivMod)
  ../lang.knl
  ../int.knl
  ../int.kn)
 (action
  (run %{bin:kanon} lean-all --check . ../lang.knl)))
