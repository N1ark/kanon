    | (Term.mk (Kind.Op3 Op3.Ite b l r) _), (Term.mk (Kind.Op3 Op3.Ite kanon__7 l' r') _) =>
    (whenSome (decide (b = kanon__7))
    ((O.b_ite b (O.sem_eq l l') (O.sem_eq r r'))))
    | _, _ => none)

def sem_eq.r_false_ (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Bool false) _), x =>
    (whenSome true ((O.b_not x)))
    | _, _ => none)
  <|> (match v1, v2 with
        | x, (Term.mk (Kind.Bool false) _) =>
        (whenSome true ((O.b_not x)))
        | _, _ => none)

def sem_eq.r_true_ (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Bool true) _), x =>
    (whenSome true (x))
    | _, _ => none)
  <|> (match v1, v2 with
        | x, (Term.mk (Kind.Bool true) _) =>
        (whenSome true (x))
        | _, _ => none)

def sem_eq.r_nots (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Op1 Op1.Not b) _), (Term.mk (Kind.Op1 Op1.Not c) _) =>
    (whenSome true ((O.sem_eq b c)))
    | _, _ => none)

def sem_eq.r_default (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome true ((Term.mk (mk_commut_binop O Op2.Eq v1 v2) Ty.TBool))))

def sem_eq.step (O : Ops) (v1 : Term) (v2 : Term) : Term :=
  (firstSome [sem_eq.r_ints O v1 v2, sem_eq.r_same O v1 v2, sem_eq.r_bools O v1 v2, sem_eq.r_ite_ite O v1 v2, sem_eq.r_false_ O v1 v2, sem_eq.r_true_ O v1 v2, sem_eq.r_nots O v1 v2, sem_eq.r_default O v1 v2]).getD (sem_eq.spec v1 v2)

def sem_eq_untyped.r_ill_typed (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome (! (decide ((ty v1) = (ty v2)))) (v_false)))

def sem_eq_untyped.r_typed (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with | _, _ => (whenSome true ((O.sem_eq v1 v2))))

def sem_eq_untyped.step (O : Ops) (v1 : Term) (v2 : Term) : Term :=
  (firstSome [sem_eq_untyped.r_ill_typed O v1 v2, sem_eq_untyped.r_typed O v1 v2]).getD (sem_eq_untyped.spec v1 v2)

def b_distinct.r_small (O : Ops) (l : (List Term)) : Option Term :=
  (match l with | _ => (whenSome (at_most_one l) (v_true)))

def b_distinct.r_distinct (O : Ops) (l : (List Term)) : Option Term :=
  (match l with
    | _ =>
    (whenSome (decide ((distinct_check l) = (some true))) (v_true)))

def b_distinct.r_not_distinct (O : Ops) (l : (List Term)) : Option Term :=
  (match l with
    | _ =>
    (whenSome (decide ((distinct_check l) = (some false))) (v_false)))

def b_distinct.r_default (O : Ops) (l : (List Term)) : Option Term :=
  (match l with
    | _ =>
    (whenSome true
    ((Term.mk (Kind.OpN OpN.Distinct (O.orc.sort_by_tag l)) Ty.TBool))))

def b_distinct.step (O : Ops) (l : (List Term)) : Term :=
  (firstSome [b_distinct.r_small O l, b_distinct.r_distinct O l, b_distinct.r_not_distinct O l, b_distinct.r_default O l]).getD (b_distinct.spec l)

def plus.r_lits (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Int i1) _), (Term.mk (Kind.Int i2) _) =>
    (whenSome true ((Term.mk (Kind.Int (add i1 i2)) Ty.TInt)))
    | _, _ => none)

def plus.r_unit_zero (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | x, (Term.mk (Kind.Int kanon__2) _) =>
    (whenSome (decide (kanon__2 = (0 : Int))) (x))
    | _, _ => none)
  <|> (match v1, v2 with
        | (Term.mk (Kind.Int kanon__2) _), x =>
        (whenSome (decide (kanon__2 = (0 : Int))) (x))
        | _, _ => none)

def plus.r_default (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome true ((Term.mk (mk_commut_binop O Op2.Plus v1 v2) Ty.TInt))))

def plus.step (O : Ops) (v1 : Term) (v2 : Term) : Term :=
  (firstSome [plus.r_lits O v1 v2, plus.r_unit_zero O v1 v2, plus.r_default O v1 v2]).getD (plus.spec v1 v2)

def int_div.r_self (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | x, y =>
    (whenSome (decide (x = y)) ((Term.mk (Kind.Int (1 : Int)) Ty.TInt))))

def int_div.r_default (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome true ((Term.mk (Kind.Op2 Op2.Div v1 v2) Ty.TInt))))

def int_div.step (O : Ops) (v1 : Term) (v2 : Term) : Term :=
  (firstSome [int_div.r_self O v1 v2, int_div.r_default O v1 v2]).getD (int_div.spec v1 v2)

def sq1.r_default (O : Ops) (v : Term) : Option Term :=
  (match v with
    | _ =>
    (whenSome true ((Term.mk (Kind.Op1 Op1.Sq1 v) Ty.TInt))))

def sq1.step (O : Ops) (v : Term) : Term :=
  (firstSome [sq1.r_default O v]).getD (sq1.spec v)

def int_lt.r_lits (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | (Term.mk (Kind.Int x) _), (Term.mk (Kind.Int y) _) =>
    (whenSome true ((of_bool (decide (x < y)))))
    | _, _ => none)

def int_lt.r_same (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | x, kanon__2 =>
    (whenSome (decide (x = kanon__2)) (v_false)))

def int_lt.r_default (O : Ops) (v1 : Term) (v2 : Term) : Option Term :=
  (match v1, v2 with
    | _, _ =>
    (whenSome true ((Term.mk (Kind.Op2 Op2.Lt v1 v2) Ty.TBool))))

def int_lt.step (O : Ops) (v1 : Term) (v2 : Term) : Term :=
  (firstSome [int_lt.r_lits O v1 v2, int_lt.r_same O v1 v2, int_lt.r_default O v1 v2]).getD (int_lt.spec v1 v2)

def opsRaw (orc : Oracle) : Ops :=
  { orc := orc,
    b_and := fun v1 v2 => b_and.spec v1 v2,
    b_or := fun v1 v2 => b_or.spec v1 v2,
    b_not := fun sv => b_not.spec sv,
    b_ite := fun guard if_ else_ => b_ite.spec guard if_ else_,
    sem_eq := fun v1 v2 => sem_eq.spec v1 v2,
    sem_eq_untyped := fun v1 v2 => sem_eq_untyped.spec v1 v2,
    b_distinct := fun l => b_distinct.spec l,
    plus := fun v1 v2 => plus.spec v1 v2,
    int_div := fun v1 v2 => int_div.spec v1 v2,
    sq1 := fun v => sq1.spec v,
    int_lt := fun v1 v2 => int_lt.spec v1 v2 }

def opsStep (O : Ops) : Ops :=
  { orc := O.orc,
    b_and := b_and.step O,
    b_or := b_or.step O,
    b_not := b_not.step O,
    b_ite := b_ite.step O,
    sem_eq := sem_eq.step O,
    sem_eq_untyped := sem_eq_untyped.step O,
    b_distinct := b_distinct.step O,
    plus := plus.step O,
    int_div := int_div.step O,
    sq1 := sq1.step O,
    int_lt := int_lt.step O }

def opsN (orc : Oracle) : Nat → Ops
  | 0 => opsRaw orc
  | n + 1 => opsStep (opsN orc n)

end DivisionExample
