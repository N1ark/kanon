import KanonBool.Node
import IntMod.Node
import IntsExample.Node

set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

noncomputable section

namespace IntsExample

open Classical Kanon

/-- The sorts of the language: those of its modules. -/
inductive Ty where
  | bool (s : KanonBool.Srt)
  | int (s : IntMod.Srt)
  deriving DecidableEq, Repr

/-- The terms of the language: the nodes of its modules, at a sort. -/
inductive Term where
  | bool (n : KanonBool.Node Term) (t : Ty)
  | int (n : IntMod.Node Term) (t : Ty)
  | lang (n : IntsExample.Node Term) (t : Ty)

/-- The sort of a term. -/
def Term.ty : Term → Ty
  | .bool _ t | .int _ t | .lang _ t => t

instance : Inhabited Ty := ⟨.bool default⟩
instance : Inhabited Term := ⟨.bool (.Bool default) default⟩

end IntsExample
