; The generated Lean files of the example, under IntsExample/, from ../lang.knl
; and its int module and the bool module built into kanon: `dune test` checks
; that they are up to date (run `dune exec -- kanon lean-all . ../lang.knl`
; here after changing the language or the modules), and CI checks their proofs
; with `lake build`.

(rule
 (alias runtest)
 (deps
  (source_tree IntsExample)
  (source_tree IntMod)
  ../lang.knl
  ../int.knl
  ../int.kn)
 (action
  (run %{bin:kanon} lean-all --check . ../lang.knl)))
