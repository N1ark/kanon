(* The int module: integers, their sum and their order. It is proved once, in
   Lean, under IntMod (lean/IntMod), for any language that uses it. *)

[@@@lean_root "IntMod"]

node Int of int : TInt
node Plus : TInt -> TInt -> TInt [@comm] [@unit 0] [@fold add]
node Lt : TInt -> TInt -> TBool

sort TInt

notation Int

infix "+" = Plus, plus
infix "lt" = Lt, int_lt
