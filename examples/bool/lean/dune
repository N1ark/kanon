; The generated Lean files of the example, under Generated/BoolExample/, from ../lang.knl
; and the bool module built into kanon: `dune test` checks that they are up to
; date (run `dune exec -- kanon lean-all . ../lang.knl` here after changing the
; language or the modules), and CI checks their proofs with `lake build`.

(rule
 (alias runtest)
 (deps
  (source_tree Generated)
  (source_tree BoolExample)
  ../lang.knl)
 (action
  (run %{bin:kanon} lean-all --check . ../lang.knl)))
