theorem b_and.step_sound (O : Ops) (hO : O.Sound) (v1 : Term) (v2 : Term) :
  Refines (b_and.spec v1 v2) (b_and.step O v1 v2) := by
  unfold b_and.step
  refine Refinement.firstSome_cons (fun res h => b_and.r_same.proof O hO v1 v2 res h) ?_
  refine Refinement.firstSome_cons (fun res h => b_and.r_false_.proof O hO v1 v2 res h) ?_
  refine Refinement.firstSome_cons (fun res h => b_and.r_true_.proof O hO v1 v2 res h) ?_
  refine Refinement.firstSome_cons (fun res h => b_and.r_not.proof O hO v1 v2 res h) ?_
  refine Refinement.firstSome_cons (fun res h => b_and.r_and_.proof O hO v1 v2 res h) ?_
  refine Refinement.firstSome_cons (fun res h => b_and.r_or_.proof O hO v1 v2 res h) ?_
  refine Refinement.firstSome_cons (fun res h => b_and.r_eq_neq.proof O hO v1 v2 res h) ?_
  refine Refinement.firstSome_cons (fun res h => b_and.r_default.proof O hO v1 v2 res h) ?_
  exact Refinement.firstSome_nil

