; The generated Lean files of the example, from ../../lang.knl and the bool
; module built into kanon, which it uses: `dune test` checks that the
; committed files are up to date (run `dune promote` after changing the
; language or the module), and CI checks their proofs with `lake build`.

(rule
 (deps ../../lang.knl)
 (targets
  Types.lean.gen
  Syntax.lean.gen
  Signatures.lean.gen
  Typing.lean.gen
  Model.lean.gen
  Statements.lean.gen
  Lifts.lean.gen
  Soundness.lean.gen)
 (action
  (run %{bin:kanon} lean-all ../../lang.knl)))

(rule
 (alias runtest)
 (action
  (progn
   (diff Types.lean Types.lean.gen)
   (diff Syntax.lean Syntax.lean.gen)
   (diff Signatures.lean Signatures.lean.gen)
   (diff Typing.lean Typing.lean.gen)
   (diff Model.lean Model.lean.gen)
   (diff Statements.lean Statements.lean.gen)
   (diff Lifts.lean Lifts.lean.gen)
   (diff Soundness.lean Soundness.lean.gen))))
