(* An example language made of Kanon's bool module alone (modules/bool.kn[l],
   built into kanon as +bool): its terms are boolean literals, variables and
   the nodes of the module, which Kanon places in the types below. Its Lean
   model is in lean/; [kanon ocaml-types] and [kanon ocaml] generate its OCaml
   types and rules, with the primitives of the module [Prims]. *)

[@@@lean_root "BoolExample"]
[@@@ocaml_prims "Prims"]

use +bool

type var [@ocaml "string"] [@lean "Int"] [@noeq]

type t =
  | Var of var
  | Unop of unop * t [@operators]
  | Binop of binop * t * t [@operators]
  | Triop of triop * t * t * t [@operators]
  | Nop of nop * t list [@operators]

type unop
type binop
type triop
type nop = Distinct
type ty
