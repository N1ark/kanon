; Kanon in a web page (see README.md): dune build @web builds dist/, the
; directory to serve, with kanon.js. Without js_of_ocaml (and zarith_stubs_js),
; dune build skips this directory, and dune build @web fails.

; kanon_web is a test only for its build_if, which, unlike the enabled_if of an
; executable, can depend on the libraries; it is not run by dune test, but by
; node web/test.mjs.

(test
 (name kanon_web)
 (build_if
  (and %{lib-available:js_of_ocaml} %{lib-available:zarith_stubs_js}))
 (enabled_if false)
 (modes js)
 (libraries kanon_lib js_of_ocaml zarith_stubs_js)
 (js_of_ocaml
  (compilation_mode whole_program)
  (sourcemap no)
  (flags
   (--opt 3))
  (javascript_files stubs.js)))

(subdir
 dist
 (rule
  (enabled_if
   (and %{lib-available:js_of_ocaml} %{lib-available:zarith_stubs_js}))
  (action
   (copy ../kanon_web.bc.js kanon.js))))

(rule
 (alias web)
 (enabled_if
  (and %{lib-available:js_of_ocaml} %{lib-available:zarith_stubs_js}))
 (deps dist/kanon.js)
 (action (progn)))

(rule
 (alias web)
 (enabled_if
  (not
   (and %{lib-available:js_of_ocaml} %{lib-available:zarith_stubs_js})))
 (action
  (system
   "echo 'kanon web needs js_of_ocaml and zarith_stubs_js: opam install js_of_ocaml-compiler js_of_ocaml zarith_stubs_js' >&2; exit 1")))

; The version of kanon: git describe in the source tree (the parent of
; _build), or dev.

(rule
 (target version.ml)
 (enabled_if
  (and %{lib-available:js_of_ocaml} %{lib-available:zarith_stubs_js}))
 (deps (universe))
 (action
  (with-stdout-to
   %{target}
   (system
    "v=$(git -C \"${PWD%%/_build/*}\" describe --always --dirty 2>/dev/null || echo dev); printf 'let v = \"%s\"\\n' \"$v\""))))
