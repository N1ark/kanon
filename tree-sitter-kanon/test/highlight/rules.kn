prim lit : bv -> t
(* <- keyword *)
(*   ^ function *)
(*         ^ type *)
(*               ^ type.builtin *)

rule b_and : And (v1, v2) =
(* <- keyword *)
(*   ^ function *)
(*           ^ constructor *)
  | not: p && not p -> v_false
(*^ punctuation.delimiter *)
(*  ^ label *)
(*         ^ operator *)
(*            ^ keyword.operator *)
(*                  ^ operator *)
  | urem: l urem #n, _ when equal l n -> v_false
(*  ^ label *)
(*          ^ keyword.operator *)
(*               ^ punctuation.special *)
(*                   ^ variable.special *)
(*                     ^ keyword *)
(*                          ^ function.builtin *)
  | or_: x lor 0 -> x
(*  ^ label *)
(*         ^ keyword.operator *)
(*             ^ number *)

extend rule b_and before not =
(* <- keyword *)
(*     ^ keyword *)
(*          ^ function *)
(*                ^ keyword *)
(*                       ^ label *)
  | lit: #x, _ -> lit_of (x + 1)
(*  ^ label *)
(*                ^ function *)
(*                          ^ operator *)

fn size (v : t) : int [@ty_only] = size_of_ty (type_of v)
