use builtin "bool"
(* <- keyword *)
(*  ^ keyword *)
(*          ^ string.special.symbol *)

infix "urem" = Rem false, bv_rem false, lit_urem
(* <- keyword *)
(*    ^ string.special.symbol *)
(*             ^ constructor *)
(*                 ^ boolean *)
(*                        ^ function *)
(*                                      ^ function *)

node Add of checked : TBitVector n -> TBitVector n [@comm] [@fold lit_add]
(* <- keyword *)
(*   ^ constructor *)
(*       ^ keyword *)
(*          ^ type *)
(*                    ^ constructor *)
(*                                 ^ operator *)
(*                                                 ^ attribute *)
(*                                                   ^ attribute *)
(*                                                           ^ attribute *)
(*                                                                ^ function *)

type bv [@equal "Bv.equal"] [@ocaml "Bv.t"]
(* <- keyword *)
(*   ^ type *)
(*        ^ attribute *)
(*               ^ string *)
(*                                   ^ string *)

node Distinct : a list -> TBool
(*                 ^ type.builtin *)

constant ones (v) = bv_ones (size v)
(* <- keyword *)
(*       ^ constant *)
(*             ^ variable.parameter *)

sort TBitVector of nat [@get size]
(* <- keyword *)
(*   ^ constructor *)
(*              ^ keyword *)
(*                 ^ type.builtin *)
(*                      ^ attribute *)
(*                           ^ function *)

subsort TNonzero of nat : TBitVector n
(* <- keyword *)
(*      ^ constructor *)

node Mul : TBitVector n -> TBitVector n -> TBitVector n [@fold z_mul Lit]
(*                                                       ^ attribute *)
(*                                                             ^ function *)
(*                                                                   ^ constructor *)

notation BitVec
(* <- keyword *)
(*       ^ constructor *)

fn msb_of (v : TBitVector n) : int = (BitVec 0 : TBitVector n)
(*         ^ variable.parameter *)
(*             ^ constructor *)
(*                                    ^ constructor *)
(*                                               ^ constructor *)

prim lit : bv -> t
(* <- keyword *)
(*   ^ function *)
(*         ^ type *)
(*               ^ type.builtin *)

rule b_and : And (v1, v2) =
(* <- keyword *)
(*   ^ function *)
(*           ^ constructor *)
  | not: p && not p -> v_false
(*^ punctuation.delimiter *)
(*  ^ label *)
(*         ^ operator *)
(*            ^ keyword.operator *)
(*                  ^ operator *)
  | urem: l urem #n, _ when type_of l = n -> v_false
(*  ^ label *)
(*          ^ keyword.operator *)
(*               ^ punctuation.special *)
(*                   ^ variable.special *)
(*                     ^ keyword *)
(*                          ^ function.builtin *)
(*                                    ^ operator *)
  | le: x <=. 0 || ~x ≤ y -> x
(*  ^ label *)
(*        ^ operator *)
(*            ^ number *)
(*              ^ operator *)
(*                 ^ operator *)
(*                    ^ operator *)
  | ult: x <u #y -> x <=s y
(*  ^ label *)
(*         ^ operator *)
(*            ^ punctuation.special *)
(*                    ^ operator *)

extend rule b_and before not =
(* <- keyword *)
(*     ^ keyword *)
(*          ^ function *)
(*                ^ keyword *)
(*                       ^ label *)
  | lit: #x, _ -> lit_of (x + 1)
(*  ^ label *)
(*                ^ function *)
(*                          ^ operator *)

fn size (v : t) : int [@ty_only] = size_of_ty (type_of v)
(* <- keyword *)
(* ^ function *)
(*       ^ variable.parameter *)
(*                ^ type.builtin *)
(*                      ^ attribute *)
(*                                 ^ function *)
(*                                             ^ function.builtin *)

(** A doc comment *)
(* <- comment.doc *)
(* A comment (* nested *) *)
(* <- comment *)

fn swap (a : int array) : int array = array_set a 0 ([| 1 |] = a)
(* <- keyword *)
(*               ^ type.builtin *)
(*                            ^ type.builtin *)
(*                                    ^ function.builtin *)
(*                                                   ^ punctuation.bracket *)
