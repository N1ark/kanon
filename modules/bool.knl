(* The bool module, at the bottom of every language: booleans, equality, [Ite]
   and [Distinct]. See the README of Kanon for the syntax. *)

node Bool of bool [@literal] [@to_term "of_bool"]
node Not : TBool -> TBool
node And : TBool -> TBool -> TBool [@comm] [@idem]
node Or : TBool -> TBool -> TBool [@comm] [@idem]
node Eq : a -> b -> TBool when a = b [@comm]
node Ite : TBool -> a -> a -> a [@ite]
node Distinct
node TBool

infix "&&" = And, b_and
infix "||" = Or, b_or
infix "==" = Eq, sem_eq
prefix "not" = Not, b_not

constant "true" (v) = v_true
constant "false" (v) = v_false
