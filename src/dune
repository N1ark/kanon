; Kanon as a library: the command line (Cli), the language server
; (Lsp_server) and what they are made of, for kanon and for the web runtime of
; web/.

(library
 (name kanon_lib)
 (wrapped false)
 (modules :standard \ main)
 (libraries ppxlib fmt zarith yojson unix))

(executable
 (name main)
 (public_name kanon)
 (package kanon)
 (modules main)
 (libraries kanon_lib))

(menhir
 (modules kanon_parser))

(ocamllex
 (modules kanon_lexer))

; The version of kanon, from dune-project.

(rule
 (target version.ml)
 (action
  (with-stdout-to
   %{target}
   (echo
    "(** The version of kanon. *)\nlet version = \"%{version:kanon}\"\n"))))

; The modules of modules/, built into kanon: [use builtin "bool"] uses
; modules/bool.knl and modules/bool.kn.

(rule
 (target builtin.ml)
 (deps ../modules/bool.knl ../modules/bool.kn)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "(** The built-in modules: the files of [modules/], by name. *)\n")
    (echo "let files = [\n  (\"bool.knl\", {kanon|")
    (cat ../modules/bool.knl)
    (echo "|kanon});\n  (\"bool.kn\", {kanon|")
    (cat ../modules/bool.kn)
    (echo "|kanon});\n]\n")))))
